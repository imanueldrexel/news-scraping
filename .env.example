# ============================================
# Indonesian News Scraper Microservices
# Environment Configuration
# ============================================

# --------------------------------------------
# PostgreSQL Configuration
# --------------------------------------------
POSTGRES_USER=news
POSTGRES_PASSWORD=news123
POSTGRES_DB=newsdb
DATABASE_URL=postgresql://news:news123@postgres:5432/newsdb

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
REDIS_URL=redis://redis:6379

# --------------------------------------------
# Neo4j Configuration
# --------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_URI=bolt://neo4j:7687

# --------------------------------------------
# ChromaDB Configuration
# --------------------------------------------
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# --------------------------------------------
# Ollama Configuration
# --------------------------------------------
OLLAMA_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text

# --------------------------------------------
# Service Configuration
# --------------------------------------------
# Ingestion Service
POLLING_INTERVAL=300  # Sitemap polling interval in seconds

# Preprocessor Service
RELEVANCE_THRESHOLD=0.35  # Minimum relevance score (0-1)

# Entity Resolver Service
FUZZY_THRESHOLD=0.85  # Fuzzy matching threshold (0-1)

# Analyst Service
SIMILARITY_THRESHOLD=0.85  # Cluster similarity threshold (0-1)

# --------------------------------------------
# Logging
# --------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# --------------------------------------------
# Stream Names (Redis Streams)
# --------------------------------------------
STREAM_INGESTED=stream:ingested
STREAM_PREPROCESSED=stream:preprocessed
STREAM_VECTORIZED=stream:vectorized
STREAM_TRIPLETS=stream:triplets
STREAM_ENTITIES=stream:entities
